# CORTEX configuration file
# Copy to /etc/cortex/cortex.env (systemd) or mount into container

# Database
CORTEX_DB_PATH=/var/lib/cortex/cortex.db

# API
CORTEX_API_HOST=127.0.0.1
CORTEX_API_PORT=8777
CORTEX_API_AUTH_REQUIRED=true
# Preferred multi-token format: token:scope1,scope2;token2:scope1
CORTEX_API_TOKENS=
# Single-token shortcut
CORTEX_API_TOKEN=
CORTEX_API_SCOPES=read,write

# API hardening
CORTEX_API_RATE_LIMIT_WINDOW_MS=60000
CORTEX_API_RATE_LIMIT_MAX=120
CORTEX_API_REQUEST_LOGGING=true

# Paths (optional overrides)
# CORTEX_CLI_PATH=/opt/cortex/cortex.js
# CORTEX_DAEMON_PATH=/opt/cortex/cortexd.js
